utc: 2026-10-27T19:18:52Z
command: bash -c for t in catalog.product.events catalog.attribute.events catalog.category.events; do end=$(docker exec redpanda rpk topic describe -p $t | awk "NR==2{print \$6}"); h=$(docker exec redpanda rpk topic consume $t -n $end -f "%h{%k=%v;}\n" 2>/dev/null); echo "== $t on Redpanda: records=$end"; echo "$h" | grep -o "x-tenant-slug=[a-z0-9-]*" | sort | uniq -c; echo "unique event_ids: $(echo "$h" | grep -o "event_id=[0-9a-f-]*" | sort -u | wc -l)"; done
exit: 0

+func TestValidateSku(t *testing.T) {
+	tests := []struct {
+		name        string
+		sku         *string
+		wantErr     bool
+		errContains string
+	}{
+		{
+			name:    "nil sku is allowed",
+			sku:     nil,
+			wantErr: false,
+		},
+		{
+			name:    "valid sku",
+			sku:     ptr("SKU-1"),
+			wantErr: false,
+		},
+		{
+			name:    "sku at max length",
+			sku:     ptr(strings.Repeat("a", 64)),
+			wantErr: false,
+		},
+		{
+			name:    "multibyte sku at max length counts runes",
+			sku:     ptr(strings.Repeat("é", 64)),
+			wantErr: false,
+		},
+		{
+			name:        "empty sku",
+			sku:         ptr(""),
+			wantErr:     true,
+			errContains: "sku cannot be empty",
+		},
+		{
+			name:        "sku too long",
+			sku:         ptr(strings.Repeat("a", 65)),
+			wantErr:     true,
+			errContains: "sku is too long",
+		},
+		{
+			name:        "multibyte sku too long",
+			sku:         ptr(strings.Repeat("é", 65)),
+			wantErr:     true,
+			errContains: "sku is too long",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := validateSku(tt.sku)
+
+			if tt.wantErr {
+				require.Error(t, err)
+				assert.ErrorIs(t, err, ErrInvalidProductData)
+				assert.Contains(t, err.Error(), tt.errContains)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}

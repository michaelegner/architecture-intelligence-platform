diff --git a/ecommerce-product-query-service/internal/infrastructure/outbound/mongo/product_view_mapper_test.go b/ecommerce-product-query-service/internal/infrastructure/outbound/mongo/product_view_mapper_test.go
new file mode 100644
index 0000000..7a5d0f0
--- /dev/null
+++ b/ecommerce-product-query-service/internal/infrastructure/outbound/mongo/product_view_mapper_test.go
@@ -0,0 +1,66 @@
+package mongo
+
+import (
+	"testing"
+	"time"
+
+	"github.com/Sokol111/ecommerce-product-query-service/internal/application/productview"
+)
+
+func TestProductViewMapper_SkuRoundTrip(t *testing.T) {
+	tests := []struct {
+		name string
+		sku  *string
+	}{
+		{
+			name: "non-nil sku",
+			sku:  new("SKU-1"),
+		},
+		{
+			name: "nil sku",
+			sku:  nil,
+		},
+	}
+
+	mapper := NewProductViewMapper()
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			now := time.Now().UTC()
+			view := productview.NewProductView(
+				"prod-123",
+				1,
+				"Test Product",
+				nil,
+				tt.sku,
+				10.0,
+				1,
+				nil,
+				nil,
+				false,
+				now,
+				now,
+				nil,
+				nil,
+			)
+
+			entity := mapper.ToEntity(view)
+			assertSkuEqual(t, tt.sku, entity.Sku)
+
+			restored := mapper.ToDomain(entity)
+			assertSkuEqual(t, tt.sku, restored.Sku)
+		})
+	}
+}
+
+func assertSkuEqual(t *testing.T, want, got *string) {
+	t.Helper()
+	switch {
+	case want == nil && got != nil:
+		t.Fatalf("expected nil sku, got %q", *got)
+	case want != nil && got == nil:
+		t.Fatalf("expected sku %q, got nil", *want)
+	case want != nil && *want != *got:
+		t.Fatalf("expected sku %q, got %q", *want, *got)
+	}
+}
-- 

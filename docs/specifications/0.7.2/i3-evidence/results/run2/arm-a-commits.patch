@@ -0,0 +1,71 @@
+package kafka
+
+import (
+	"context"
+	"testing"
+
+	"go.uber.org/zap"
+
+	catalog_eventsv1 "github.com/Sokol111/ecommerce-catalog-service-api/gen/go/catalog/events/v1"
+	"github.com/Sokol111/ecommerce-commons/pkg/core/logger"
+	"github.com/Sokol111/ecommerce-product-query-service/internal/application/productview"
+)
+
+// fakeUpsertHandler records the last command it received.
+type fakeUpsertHandler struct {
+	cmd *productview.UpsertProductCommand
+}
+
+func (f *fakeUpsertHandler) Handle(_ context.Context, cmd productview.UpsertProductCommand) error {
+	f.cmd = &cmd
+	return nil
+}
+
+func TestProductHandler_HandleProductUpdated_Sku(t *testing.T) {
+	tests := []struct {
+		name string
+		sku  *string
+	}{
+		{
+			name: "projects sku from event",
+			sku:  new("SKU-1"),
+		},
+		{
+			name: "nil event sku gives nil view sku",
+			sku:  nil,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := logger.With(context.Background(), zap.NewNop())
+			upsert := &fakeUpsertHandler{}
+			handler := NewProductHandler(upsert, nil, nil)
+
+			event := &catalog_eventsv1.ProductUpdatedEvent{
+				ProductId: "prod-123",
+				Name:      "Test Product",
+				Version:   2,
+				Sku:       tt.sku,
+			}
+
+			if err := handler.HandleProductUpdated(ctx, event); err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			if upsert.cmd == nil || upsert.cmd.Product == nil {
+				t.Fatal("expected upsert command with product")
+			}
+
+			got := upsert.cmd.Product.Sku
+			switch {
+			case tt.sku == nil && got != nil:
+				t.Fatalf("expected nil sku, got %q", *got)
+			case tt.sku != nil && got == nil:
+				t.Fatalf("expected sku %q, got nil", *tt.sku)
+			case tt.sku != nil && *tt.sku != *got:
+				t.Fatalf("expected sku %q, got %q", *tt.sku, *got)
+			}
+		})
+	}
+}

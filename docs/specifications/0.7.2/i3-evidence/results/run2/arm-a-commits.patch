+// validateSku validates the optional SKU. Length is counted in runes to match
+// protovalidate's string max_len.
+func validateSku(sku *string) error {
+	if sku == nil {
+		return nil
+	}
+
+	if *sku == "" {
+		return fmt.Errorf("%w: sku cannot be empty", ErrInvalidProductData)
+	}
+
+	if utf8.RuneCountInString(*sku) > 64 {
+		return fmt.Errorf("%w: sku is too long (max 64 characters)", ErrInvalidProductData)
+	}
+
+	return nil
+}

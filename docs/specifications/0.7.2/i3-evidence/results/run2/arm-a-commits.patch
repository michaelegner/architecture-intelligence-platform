+		5,
+		nil,
+		nil,
+		false,
+		nil,
+	)
+	require.NoError(t, err)
+
+	err = testProductRepo.Insert(ctx, prod)
+	require.NoError(t, err)
+
+	// Update keeping the SKU - full replace must not drop it
+	err = prod.Update("SKU Product Renamed", nil, prod.Sku, 10.00, 5, nil, nil, false, nil)
+	require.NoError(t, err)
+
+	prod, err = testProductRepo.Update(ctx, prod)
+	require.NoError(t, err)
+
+	found, err := testProductRepo.FindByID(ctx, prod.ID)
+	require.NoError(t, err)
+	require.NotNil(t, found.Sku)
+	assert.Equal(t, "SKU-1", *found.Sku)
+
+	// Update without a SKU clears it
+	err = found.Update("SKU Product Renamed", nil, nil, 10.00, 5, nil, nil, false, nil)
+	require.NoError(t, err)
+
+	_, err = testProductRepo.Update(ctx, found)
+	require.NoError(t, err)
+
+	found, err = testProductRepo.FindByID(ctx, prod.ID)
+	require.NoError(t, err)
+	assert.Nil(t, found.Sku)

+// validateSKU validates the optional SKU (nil means not set)
+func validateSKU(sku *string) error {
+	if sku == nil {
+		return nil
+	}
+
+	if *sku == "" {
+		return fmt.Errorf("%w: sku cannot be empty", ErrInvalidProductData)
+	}
+
+	if len(*sku) > 64 {
+		return fmt.Errorf("%w: sku is too long (max 64 characters)", ErrInvalidProductData)
+	}
+
+	if !skuPattern.MatchString(*sku) {
+		return fmt.Errorf("%w: sku contains invalid characters", ErrInvalidProductData)
+	}
+
+	return nil
+}

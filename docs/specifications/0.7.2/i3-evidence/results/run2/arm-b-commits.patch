@@ -0,0 +1,75 @@
+package kafka
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	catalog_eventsv1 "github.com/Sokol111/ecommerce-catalog-service-api/gen/go/catalog/events/v1"
+	"github.com/Sokol111/ecommerce-commons/pkg/core/logger"
+	"github.com/Sokol111/ecommerce-product-query-service/internal/application/productview"
+	"go.uber.org/zap"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+// fakeUpsertHandler records the commands it receives.
+type fakeUpsertHandler struct {
+	cmds []productview.UpsertProductCommand
+}
+
+func (f *fakeUpsertHandler) Handle(_ context.Context, cmd productview.UpsertProductCommand) error {
+	f.cmds = append(f.cmds, cmd)
+	return nil
+}
+
+func newTestEvent(sku *string) *catalog_eventsv1.ProductUpdatedEvent {
+	now := timestamppb.New(time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC))
+	return &catalog_eventsv1.ProductUpdatedEvent{
+		ProductId:  "product-123",
+		Name:       "Test Product",
+		Price:      99.99,
+		Quantity:   10,
+		Version:    2,
+		CreatedAt:  now,
+		ModifiedAt: now,
+		Sku:        sku,
+	}
+}
+
+func TestProductHandler_HandleProductUpdated_SKU(t *testing.T) {
+	ctx := logger.With(context.Background(), zap.NewNop())
+
+	t.Run("sku set", func(t *testing.T) {
+		upsert := &fakeUpsertHandler{}
+		h := NewProductHandler(upsert, nil, nil)
+		sku := "SKU-123"
+
+		if err := h.HandleProductUpdated(ctx, newTestEvent(&sku)); err != nil {
+			t.Fatalf("HandleProductUpdated() error = %v", err)
+		}
+
+		if len(upsert.cmds) != 1 {
+			t.Fatalf("upsert called %d times, want 1", len(upsert.cmds))
+		}
+		got := upsert.cmds[0].Product.SKU
+		if got == nil || *got != sku {
+			t.Fatalf("Product.SKU = %v, want %q", got, sku)
+		}
+	})
+
+	t.Run("sku nil", func(t *testing.T) {
+		upsert := &fakeUpsertHandler{}
+		h := NewProductHandler(upsert, nil, nil)
+
+		if err := h.HandleProductUpdated(ctx, newTestEvent(nil)); err != nil {
+			t.Fatalf("HandleProductUpdated() error = %v", err)
+		}
+
+		if len(upsert.cmds) != 1 {
+			t.Fatalf("upsert called %d times, want 1", len(upsert.cmds))
+		}
+		if got := upsert.cmds[0].Product.SKU; got != nil {
+			t.Fatalf("Product.SKU = %q, want nil", *got)
+		}
+	})
+}

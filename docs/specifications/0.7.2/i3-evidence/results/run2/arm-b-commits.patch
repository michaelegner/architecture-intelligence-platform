+package mongo
+
+import (
+	"testing"
+	"time"
+
+	"github.com/Sokol111/ecommerce-product-query-service/internal/application/productview"
+)
+
+func newTestProductView(sku *string) *productview.ProductView {
+	now := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	return productview.NewProductView(
+		"product-123",
+		2,
+		"Test Product",
+		nil,
+		sku,
+		99.99,
+		10,
+		nil,
+		nil,
+		false,
+		now,
+		now,
+		nil,
+		nil,
+	)
+}
+
+func TestProductViewMapper_SKURoundTrip(t *testing.T) {
+	mapper := NewProductViewMapper()
+
+	t.Run("sku set", func(t *testing.T) {
+		sku := "SKU-123"
+
+		entity := mapper.ToEntity(newTestProductView(&sku))
+		if entity.SKU == nil || *entity.SKU != sku {
+			t.Fatalf("entity.SKU = %v, want %q", entity.SKU, sku)
+		}
+
+		restored := mapper.ToDomain(entity)
+		if restored.SKU == nil || *restored.SKU != sku {
+			t.Fatalf("restored.SKU = %v, want %q", restored.SKU, sku)
+		}
+	})
+
+	t.Run("sku nil", func(t *testing.T) {
+		entity := mapper.ToEntity(newTestProductView(nil))
+		if entity.SKU != nil {
+			t.Fatalf("entity.SKU = %q, want nil", *entity.SKU)
+		}
+
+		restored := mapper.ToDomain(entity)
+		if restored.SKU != nil {
+			t.Fatalf("restored.SKU = %q, want nil", *restored.SKU)
+		}
+	})
+}

@@ -0,0 +1,49 @@
+package kafka
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/Sokol111/ecommerce-catalog-service/internal/application/product"
+)
+
+func testProduct(sku *string) *product.Product {
+	now := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	return product.Reconstruct(
+		"product-123",
+		3,
+		"Test Product",
+		new("Test description"),
+		sku,
+		99.99,
+		10,
+		new("image-123"),
+		new("category-123"),
+		true,
+		nil,
+		now,
+		now,
+	)
+}
+
+func TestNewProductUpdatedEvent_MapsSKU(t *testing.T) {
+	f := &productEventFactory{}
+
+	t.Run("sku set", func(t *testing.T) {
+		event := f.newProductUpdatedEvent(testProduct(new("SKU-123")))
+
+		require.NotNil(t, event.Sku)
+		assert.Equal(t, "SKU-123", *event.Sku)
+		assert.Equal(t, "product-123", event.ProductId)
+		assert.Equal(t, int64(3), event.Version)
+	})
+
+	t.Run("sku nil", func(t *testing.T) {
+		event := f.newProductUpdatedEvent(testProduct(nil))
+
+		assert.Nil(t, event.Sku)
+	})
+}

+/**
+ * Same-chain isolation gate: one minimal task-step invocation per arm, checked against that arm.
+ * With `swap`, each arm gets the other arm's MCP config; both checks must then fail.
+ */
+export async function checkArms(config: CliConfig, swap: boolean): Promise<boolean> {
+  const arms = config.arms;
+  if (!arms) throw new Error("--check-arms needs `arms` in the fixture");
+  const invoke = getInvoker(config.agent);
+  let allPassed = true;
+  for (const arm of ["baseline", "contextEnhanced"] as const) {
+    const other = arm === "baseline" ? "contextEnhanced" : "baseline";
+    const options = armOptions(config, arm, "task", READ_ONLY_BLOCKED);
+    let init: Record<string, unknown> | undefined;
+    const outcome = await invoke({
+      ...options,
+      mcpConfig: swap ? arms[other].mcpConfig : arms[arm].mcpConfig,
+      checkInit: (e) => { init = e; return undefined; },
+      prompt: "Reply with the single word OK.",
+      cwd: config.repo,
+      model: config.model,
+      dangerouslySkipPermissions: false,
+      timeoutMs: 120_000,
+      verbose: config.verbose,
+      tag: `check:${arm}`,
+    }).then(() => undefined, (e: unknown) => String(e));
+    const problem = outcome ?? (init ? checkArmInit(arms, arm, "task", init) : "no system/init event");
+    const servers = ((init?.mcp_servers as Array<{ name: string; status: string }>) ?? []).map((x) => `${x.name}:${x.status}`);
+    const tools = ((init?.tools as string[]) ?? []).filter((t) => t.startsWith("mcp__"));
+    console.log(`${problem ? "FAIL" : "PASS"}  ${arms[arm].name}${swap ? " (swapped config)" : ""}: servers [${servers.join(", ")}], ${tools.length} MCP tools [${tools.join(", ")}]${problem ? ` - ${problem}` : ""}`);
+    allPassed &&= !problem;
+  }
+  return allPassed;
+}

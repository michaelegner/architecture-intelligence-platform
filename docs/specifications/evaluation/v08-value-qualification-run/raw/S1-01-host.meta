command: bash -c uname -r; echo "cgroup fs: $(stat -fc %T /sys/fs/cgroup)"; docker version --format "docker {{.Server.Version}}"; docker compose version; k3d version; tilt version; helm version --short; kubectl version --client; echo "--- listeners on run ports:"; ss -ltn | awk "NR>1{print \$4}" | grep -E ":(80|443|3001|3002|5000|8000|8080|9000|9001|9092|9093|10350|19092|27017|29092)\$" || echo none; echo "--- dangling images: $(docker images -qf dangling=true | wc -l)"; echo "--- containers:"; docker ps -a --format "{{.Names}}"; echo "--- k3d clusters:"; k3d cluster list

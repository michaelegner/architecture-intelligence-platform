{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "mcp__aip",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Edit(/__WORKSPACE__/plan.json)",
      "Edit(/__WORKSPACE__/plan.md)",
      "Edit(/__WORKSPACE__/answers.json)",
      "Edit(/__WORKSPACE__/requests.json)"
    ],
    "deny": [
      "Read(/__AIP_CHECKOUT__/**)",
      "Edit(/__AIP_CHECKOUT__/**)",
      "Read(/__RUN_HOME__/package/**)",
      "Read(/__RUN_HOME__/src/**)",
      "Read(/__RUN_HOME__/aip/**)",
      "Read(/__RUN_HOME__/catalogue/**)",
      "Read(/__OTHER_SESSIONS__/**)",
      "Read(/__OPERATOR_STATE__)",
      "Edit(//**/.claude/**)",
      "Edit(/__CONFIG__/**)",
      "WebFetch",
      "WebSearch",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(rpk:*)",
      "Bash(k3d:*)",
      "Bash(kafka-topics.sh:*)",
      "Bash(kafka-consumer-groups.sh:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "autoMemoryEnabled": false
}

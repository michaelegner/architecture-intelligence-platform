{
  "encoding": "ld(parts) = for each part: 8-byte big-endian UTF-8 byte length + UTF-8 bytes; digest = lowercase hex SHA-256 (app.common.encoding convention)",
  "vectors": [
    {
      "id": "V01",
      "formula": "gateway-consumer:owned:<sha256(ld(gateway_instance_id, username))>",
      "inputs": {
        "gateway_instance_id": "gw-prod-1",
        "username": "spike-alpha"
      },
      "expected": "gateway-consumer:owned:c7673a877c35021ca85c216009c3e95813769cc3e08d6bb02a497078771103c5"
    },
    {
      "id": "V02",
      "formula": "same username, other instance is a distinct id",
      "inputs": {
        "gateway_instance_id": "gw-prod-2",
        "username": "spike-alpha"
      },
      "expected": "gateway-consumer:owned:0f705ed8e15909f69234f14c4016dd49448822f7281d21a4df9002ef4d37061c"
    },
    {
      "id": "V03",
      "formula": "gateway-route:owned:<sha256(ld(gateway_instance_id, route_id))>",
      "inputs": {
        "gateway_instance_id": "gw-prod-1",
        "route_id": "orders-route"
      },
      "expected": "gateway-route:owned:b13aab6ea0a025474585707f644ea346dfa0e702f2cf527375298ba22cedfa6c"
    },
    {
      "id": "V04",
      "formula": "gateway-service:owned:<sha256(ld(gateway_instance_id, service_id))>",
      "inputs": {
        "gateway_instance_id": "gw-prod-1",
        "service_id": "orders"
      },
      "expected": "gateway-service:owned:04db17e7a322fde6388bd3b025c69263d4cb19781d02fadda25e33450ff19707"
    },
    {
      "id": "V05",
      "formula": "a route and a service with the same raw id are distinct ids (kind prefix)",
      "inputs": {
        "gateway_instance_id": "gw-prod-1",
        "route_id": "orders",
        "service_id": "orders"
      },
      "expected": {
        "route": "gateway-route:owned:04db17e7a322fde6388bd3b025c69263d4cb19781d02fadda25e33450ff19707",
        "service": "gateway-service:owned:04db17e7a322fde6388bd3b025c69263d4cb19781d02fadda25e33450ff19707"
      }
    },
    {
      "id": "V06",
      "formula": "configured-access:owned:<sha256(ld(consumer id, route id, rule kind))>",

      "expected": "configured-access:owned:e1740ad29a54e5f8fcd89b54b545df39a65c930fd2eff91fb38c09830571c9eb"
    },
    {
      "id": "V07",
      "formula": "source instance id: urn:aip:source:apisix:<sha256(ld(configured source id, gateway_instance_id))>",
      "inputs": {
        "configured_source_id": "apisix-prod",

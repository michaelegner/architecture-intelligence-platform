    {
      "id": "Q01",
      "spec_case": "P1",
      "description": "configured C->R plus attributed upstream delta",
      "configured_access": [
        [
          "spike-alpha",
          "orders-route"
        ]
      ],
      "manifest_patch": {},
      "series": [
        {
          "route": "orders-route",
          "consumer": "spike-alpha",
          "code": "200",
          "response_source": "upstream",
          "start": 2,
          "end": 5
        }
      ],
      "expected_rows": [
        {
          "consumer": "spike-alpha",
          "route": "orders-route",
          "configured_status": "CONFIGURED_ACCESS_ESTABLISHED",
          "usage_status": "OBSERVED_USAGE",
          "coverage": "SUFFICIENT_FOR_ZERO",

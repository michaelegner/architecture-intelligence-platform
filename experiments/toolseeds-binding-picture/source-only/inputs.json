      "lines": [
        {
          "line": 1,
          "text": "package events"
        },
        {
          "line": 2,
          "text": ""
        },
        {
          "line": 3,
          "text": "import ("
        },
        {
          "line": 4,
          "text": "\teventsv1 \"github.com/Sokol111/ecommerce-catalog-service-api/gen/go/catalog/events/v1\""
        },
        {
          "line": 5,
          "text": "\t\"google.golang.org/protobuf/proto\""
        },
        {
          "line": 6,
          "text": "\t\"google.golang.org/protobuf/reflect/protoreflect\""
        },
        {
          "line": 7,
          "text": ")"
        },
        {
          "line": 8,
          "text": ""
        },
        {
          "line": 9,
          "text": "// Topic constants"
        },
        {
          "line": 10,
          "text": "const ("
        },
        {
          "line": 11,
          "text": "\tTopicCatalogProductEvents   = \"catalog.product.events\""
        },
        {
          "line": 12,
          "text": "\tTopicCatalogCategoryEvents  = \"catalog.category.events\""
        },
        {
          "line": 13,
          "text": "\tTopicCatalogAttributeEvents = \"catalog.attribute.events\""
        },
        {
          "line": 14,
          "text": ")"
        },
        {
          "line": 15,
          "text": ""
        },
        {
          "line": 16,
          "text": "// topicMap maps proto message full names to their Kafka topics."
        },
        {
          "line": 17,
          "text": "var topicMap = map[protoreflect.FullName]string{"
        },
        {
          "line": 18,
          "text": "\t(&eventsv1.ProductUpdatedEvent{}).ProtoReflect().Descriptor().FullName():   TopicCatalogProductEvents,"
        },
        {
          "line": 19,
          "text": "\t(&eventsv1.ProductDeletedEvent{}).ProtoReflect().Descriptor().FullName():   TopicCatalogProductEvents,"
        },
        {
          "line": 20,
          "text": "\t(&eventsv1.CategoryUpdatedEvent{}).ProtoReflect().Descriptor().FullName():  TopicCatalogCategoryEvents,"
        },
        {
          "line": 21,
          "text": "\t(&eventsv1.AttributeUpdatedEvent{}).ProtoReflect().Descriptor().FullName(): TopicCatalogAttributeEvents,"
        },
        {
          "line": 22,
          "text": "}"
        },
        {
          "line": 23,
          "text": ""
        },
        {
          "line": 24,
          "text": "// TopicFor returns the Kafka topic for the given proto message."
        },
        {
          "line": 25,
          "text": "// Panics if the message type is not registered in topicMap."
        },
        {
          "line": 26,
          "text": "func TopicFor(msg proto.Message) string {"
        },
        {
          "line": 27,
          "text": "\tfullName := msg.ProtoReflect().Descriptor().FullName()"
        },
        {
          "line": 28,
          "text": "\ttopic, ok := topicMap[fullName]"
        },
        {
          "line": 29,
          "text": "\tif !ok {"
        },
        {
          "line": 30,
          "text": "\t\tpanic(\"events: no topic registered for \" + string(fullName))"
        },
        {
          "line": 31,
          "text": "\t}"
        },
        {
          "line": 32,
          "text": "\treturn topic"
        },
        {
          "line": 33,
          "text": "}"
        },
        {
          "line": 34,
          "text": ""
        }
      ]
    },

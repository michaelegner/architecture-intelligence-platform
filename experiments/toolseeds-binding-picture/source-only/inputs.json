    {
      "kind": "architecture_document",
      "repo": "Sokol111/ecommerce-workspace",
      "revision": "f6b4c1ce723cb3be83eda73d74b2bacb9c584f17",
      "path": "docs/architecture/product-update-flow.md",
      "owner_service": null,
      "lines": [
        {
          "line": 20,
          "text": "    Merchant->>Admin: Edit product details or selected image"
        },
        {
          "line": 21,
          "text": "    Admin->>Catalog: UpdateProduct (Connect-RPC)"
        },
        {
          "line": 22,
          "text": "    Catalog->>CatalogDB: Commit product state + event to outbox"
        },
        {
          "line": 23,
          "text": "    Catalog-->>Admin: Product updated"
        },
        {
          "line": 24,
          "text": ""
        },
        {
          "line": 25,
          "text": "    Catalog->>Events: Publish ProductUpdated event"
        },
        {
          "line": 26,
          "text": ""
        },
        {
          "line": 27,
          "text": "    par Update product read model"
        },
        {
          "line": 28,
          "text": "        Events->>ProductQuery: Consume ProductUpdated event"
        },
        {
          "line": 29,
          "text": "        ProductQuery->>ProductDB: Upsert versioned product projection"
        },
        {
          "line": 30,
          "text": "    and Promote selected image when supplied"
        },
        {
          "line": 31,
          "text": "        Events->>Image: Consume ProductUpdated event"
        },
        {
          "line": 32,
          "text": "        Image->>Image: Promote draft image for product"
        },
        {
          "line": 33,
          "text": "        Image->>Events: Publish ProductImagePromoted event"
        },
        {
          "line": 34,
          "text": "        Events->>ProductQuery: Consume image promotion event"
        },
        {
          "line": 35,
          "text": "        ProductQuery->>ProductDB: Update image delivery URLs"
        },
        {
          "line": 36,
          "text": "    end"
        }
      ]
    },

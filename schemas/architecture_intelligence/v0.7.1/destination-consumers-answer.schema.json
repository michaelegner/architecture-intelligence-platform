{
  "$defs": {
    "AttachmentEvidence": {
      "additionalProperties": false,
      "description": "The broker path: group G attached to the queried Topic at T, from one accepted capture. No\nmember, client or host text exists in AIP state, so none can appear here.",
      "properties": {
        "capture_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Capture Content Sha256",
          "type": "string"
        },
        "capture_source_instance_id": {
          "pattern": "^urn:aip:source:kafka-consumer-state:[0-9a-f]{64}$",
          "title": "Capture Source Instance Id",
          "type": "string"
        },
        "capture_source_revision": {
          "minLength": 1,
          "title": "Capture Source Revision",
          "type": "string"
        },
        "captured_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "title": "Captured At",
          "type": "string"
        },
        "consumer_id": {
          "pattern": "^consumer:[0-9a-f]{64}$",
          "title": "Consumer Id",
          "type": "string"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "kind": {
          "const": "KAFKA_ATTACHMENT",
          "title": "Kind",
          "type": "string"
        },
        "topic_id": {
          "description": "Exact canonical Kafka Topic id (`topic:owned:\u2026`), not a topic name.",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "consumer_id",
        "group_id",
        "topic_id",
        "captured_at",
        "capture_source_instance_id",
        "capture_source_revision",
        "capture_content_sha256"
      ],
      "title": "AttachmentEvidence",
      "type": "object"
    },
    "AttributionOutcome": {
      "description": "The I2 outcome (`kafka-consumer-attribution` / `1`), unrenamed.",
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "AMBIGUOUS",
        "CONFLICT"
      ],
      "title": "AttributionOutcome",
      "type": "string"
    },
    "AttributionReason": {
      "description": "The I2 reasons, unrenamed.",
      "enum": [
        "SERVICE_IDENTITY_CONFLICT",
        "MAPPING_SOURCE_DISAGREEMENT",
        "SERVICE_IDENTITY_AMBIGUOUS",
        "SERVICE_NOT_DECLARED",
        "SERVICE_IDENTITY_PLACEHOLDER",
        "NO_MAPPING"
      ],
      "title": "AttributionReason",
      "type": "string"
    },
    "CaptureSource": {
      "additionalProperties": false,
      "description": "One accepted I1 capture of the requested broker and environment, with its own T (spec \u00a73:\nseveral captures are never collapsed into one invented T).",
      "properties": {
        "captured_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "title": "Captured At",
          "type": "string"
        },
        "scope_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Digest",
          "type": "string"
        },
        "source_instance_id": {
          "pattern": "^urn:aip:source:kafka-consumer-state:[0-9a-f]{64}$",
          "title": "Source Instance Id",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "source_instance_id",
        "captured_at",
        "source_revision",
        "scope_digest"
      ],
      "title": "CaptureSource",
      "type": "object"
    },
    "ConsumerRow": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "service_id"
              ]
            },
            "properties": {
              "limitations": {
                "maxItems": 0
              }
            },
            "required": [
              "reason"
            ]
          },
          "if": {
            "properties": {
              "outcome": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "reason"
              ]
            },
            "required": [
              "service_id"
            ]
          }
        }
      ],
      "description": "Spec \u00a73: one row per I1 attachment on the queried Topic, in the requested broker and\nenvironment. `consumer_id` and `group_id` are the Kafka-native group identity, not a Service\nor Subscription.",
      "properties": {
        "attachment_evidence_refs": {
          "items": {
            "pattern": "^destination-evidence:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Attachment Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "captured_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "title": "Captured At",
          "type": "string"
        },
        "consumer_id": {
          "pattern": "^consumer:[0-9a-f]{64}$",
          "title": "Consumer Id",
          "type": "string"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/RowLimitation"
          },
          "title": "Limitations",
          "type": "array",
          "uniqueItems": true
        },
        "mapping_evidence_refs": {
          "items": {
            "pattern": "^destination-evidence:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Mapping Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "outcome": {
          "$ref": "#/$defs/AttributionOutcome"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttributionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service_id": {
          "anyOf": [
            {
              "pattern": "^service:[^\\s\\x00-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        }
      },
      "required": [
        "consumer_id",
        "group_id",
        "outcome",
        "limitations",
        "captured_at",
        "attachment_evidence_refs",
        "mapping_evidence_refs"
      ],
      "title": "ConsumerRow",
      "type": "object"
    },
    "DestinationConsumersData": {
      "additionalProperties": false,
      "description": "The query payload. `mapping_source_present` says whether any accepted mapping source exists\nfor the broker and environment, which decides `NO_MAPPING_SOURCE`.",
      "properties": {
        "capture_sources": {
          "items": {
            "$ref": "#/$defs/CaptureSource"
          },
          "minItems": 1,
          "title": "Capture Sources",
          "type": "array",
          "uniqueItems": true
        },
        "mapping_source_present": {
          "title": "Mapping Source Present",
          "type": "boolean"
        },
        "page": {
          "$ref": "#/$defs/Page"
        },
        "request_context": {
          "$ref": "#/$defs/RequestContext"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ConsumerRow"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "request_context",
        "capture_sources",
        "mapping_source_present",
        "rows",
        "page"
      ],
      "title": "DestinationConsumersData",
      "type": "object"
    },
    "DestinationConsumersEvidenceData": {
      "additionalProperties": false,
      "description": "The `mode: \"evidence\"` payload, one entry per requested ref, sorted by ref.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/EvidenceEntry"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Entries",
          "type": "array",
          "uniqueItems": true
        },
        "request_context": {
          "$ref": "#/$defs/RequestContext"
        }
      },
      "required": [
        "request_context",
        "entries"
      ],
      "title": "DestinationConsumersEvidenceData",
      "type": "object"
    },
    "EvidenceEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "kind"
                  ]
                },
                {
                  "required": [
                    "evidence"
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "kind",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "KAFKA_ATTACHMENT"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "kind": {
                    "const": "KAFKA_ATTACHMENT"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "KAFKA_SERVICE_MAPPING"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "kind": {
                    "const": "KAFKA_SERVICE_MAPPING"
                  }
                }
              }
            }
          }
        }
      ],
      "description": "One requested ref. A forged, cross-snapshot and cross-context ref are all simply\n`NOT_RESOLVED` and indistinguishable (no ref history is kept).",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KAFKA_ATTACHMENT": "#/$defs/AttachmentEvidence",
                  "KAFKA_SERVICE_MAPPING": "#/$defs/MappingEvidence"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/AttachmentEvidence"
                },
                {
                  "$ref": "#/$defs/MappingEvidence"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "pattern": "^destination-evidence:[0-9a-f]{64}$",
          "title": "Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "ref",
        "status"
      ],
      "title": "EvidenceEntry",
      "type": "object"
    },
    "EvidenceKind": {
      "description": "Spec \u00a74: the broker path and the mapping path.",
      "enum": [
        "KAFKA_ATTACHMENT",
        "KAFKA_SERVICE_MAPPING"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "RESOLVED",
        "NOT_RESOLVED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Limitation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/LimitationCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "LimitationCode": {
      "description": "Spec \u00a73: the closed top-level codes, distinct from the I2 row reasons. The first six are\nrefusals (`data` is null).",
      "enum": [
        "SNAPSHOT_NOT_AVAILABLE",
        "UNKNOWN_DESTINATION",
        "DESTINATION_NOT_KAFKA_TOPIC",
        "BROKER_MISMATCH",
        "NO_ACCEPTED_CAPTURE",
        "CURSOR_QUERY_MISMATCH",
        "CAPTURE_SCOPE_LIMITED",
        "NO_MAPPING_SOURCE",
        "MORE_ROWS_AVAILABLE",
        "EVIDENCE_REF_NOT_RESOLVED"
      ],
      "title": "LimitationCode",
      "type": "string"
    },
    "MappingEvidence": {
      "additionalProperties": false,
      "description": "The mapping path: one accepted mapping entry for group G, as written by the operator, and the\nentry's own reading in this snapshot (a declared Service id, or the reason it has none).",
      "oneOf": [
        {
          "required": [
            "service_id"
          ]
        },
        {
          "required": [
            "reason"
          ]
        }
      ],
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "consumer_id": {
          "pattern": "^consumer:[0-9a-f]{64}$",
          "title": "Consumer Id",
          "type": "string"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "kind": {
          "const": "KAFKA_SERVICE_MAPPING",
          "title": "Kind",
          "type": "string"
        },
        "mapping_source_instance_id": {
          "pattern": "^urn:aip:source:kafka-service-mapping:[0-9a-f]{64}$",
          "title": "Mapping Source Instance Id",
          "type": "string"
        },
        "mapping_source_revision": {
          "minLength": 1,
          "title": "Mapping Source Revision",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttributionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service_id": {
          "anyOf": [
            {
              "pattern": "^service:[^\\s\\x00-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        },
        "service_name": {
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "service_namespace": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Namespace"
        }
      },
      "required": [
        "kind",
        "consumer_id",
        "group_id",
        "service_name",
        "mapping_source_instance_id",
        "mapping_source_revision",
        "artifact_sha256"
      ],
      "title": "MappingEvidence",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ANSWERED",
        "PARTIAL",
        "NOT_ANSWERED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Page": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "next_cursor"
            ]
          },
          "then": {
            "properties": {
              "returned": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "returned": {
          "maximum": 200,
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "returned"
      ],
      "title": "Page",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "build_revision": {
          "title": "Build Revision",
          "type": "string"
        },
        "name": {
          "const": "architecture-intelligence-platform",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "build_revision"
      ],
      "title": "Producer",
      "type": "object"
    },
    "RequestContext": {
      "additionalProperties": false,
      "description": "Spec \u00a72: the exact query context. Page position, `limit` and `snapshot_id` are not part of\nit.",
      "properties": {
        "broker_id": {
          "description": "Declared broker id (`x-aip-broker-id`, e.g. `kafka:cluster-a`), not a bootstrap address.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Broker Id",
          "type": "string"
        },
        "destination_id": {
          "description": "Exact canonical Kafka Topic id (`topic:owned:\u2026`), not a topic name.",
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Destination Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        }
      },
      "required": [
        "destination_id",
        "broker_id",
        "environment"
      ],
      "title": "RequestContext",
      "type": "object"
    },
    "RowLimitation": {
      "additionalProperties": false,
      "description": "A non-resolving mapping entry of a RESOLVED group, with the ref of its mapping evidence.",
      "properties": {
        "mapping_evidence_ref": {
          "pattern": "^destination-evidence:[0-9a-f]{64}$",
          "title": "Mapping Evidence Ref",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/AttributionReason"
        }
      },
      "required": [
        "reason",
        "mapping_evidence_ref"
      ],
      "title": "RowLimitation",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Revision",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^aip:snapshot:v1:[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "model_revision"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "limitations": {
            "items": {
              "properties": {
                "code": {
                  "not": {
                    "enum": [
                      "BROKER_MISMATCH",
                      "CURSOR_QUERY_MISMATCH",
                      "DESTINATION_NOT_KAFKA_TOPIC",
                      "NO_ACCEPTED_CAPTURE",
                      "SNAPSHOT_NOT_AVAILABLE",
                      "UNKNOWN_DESTINATION"
                    ]
                  }
                }
              }
            }
          },
          "snapshot": {
            "not": {
              "type": "null"
            }
          }
        }
      },
      "if": {
        "properties": {
          "data": {
            "type": "null"
          }
        },
        "required": [
          "data"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "items": {
              "properties": {
                "code": {
                  "enum": [
                    "BROKER_MISMATCH",
                    "CURSOR_QUERY_MISMATCH",
                    "DESTINATION_NOT_KAFKA_TOPIC",
                    "NO_ACCEPTED_CAPTURE",
                    "SNAPSHOT_NOT_AVAILABLE",
                    "UNKNOWN_DESTINATION"
                  ]
                }
              }
            },
            "maxItems": 1,
            "minItems": 1
          },
          "outcome": {
            "const": "NOT_ANSWERED"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "data": {
                "type": "null"
              }
            },
            "required": [
              "data"
            ]
          },
          {
            "properties": {
              "mode": {
                "const": "evidence"
              }
            },
            "required": [
              "mode"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "items": {
              "properties": {
                "code": {
                  "enum": [
                    "BROKER_MISMATCH",
                    "DESTINATION_NOT_KAFKA_TOPIC",
                    "NO_ACCEPTED_CAPTURE",
                    "SNAPSHOT_NOT_AVAILABLE",
                    "UNKNOWN_DESTINATION"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "snapshot": {
            "type": "null"
          }
        },
        "required": [
          "snapshot"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "contains": {
              "properties": {
                "code": {
                  "const": "SNAPSHOT_NOT_AVAILABLE"
                }
              }
            }
          }
        },
        "required": [
          "limitations"
        ]
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "data": {
                "type": "object"
              }
            },
            "required": [
              "data"
            ]
          },
          {
            "properties": {
              "mode": {
                "const": "query"
              }
            },
            "required": [
              "mode"
            ]
          }
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "data": {
                "required": [
                  "request_context",
                  "rows"
                ]
              },
              "outcome": {
                "const": "PARTIAL"
              }
            }
          },
          {
            "properties": {
              "limitations": {
                "contains": {
                  "properties": {
                    "code": {
                      "const": "CAPTURE_SCOPE_LIMITED"
                    }
                  }
                }
              }
            },
            "required": [
              "limitations"
            ]
          },
          {
            "properties": {
              "limitations": {
                "items": {
                  "properties": {
                    "code": {
                      "not": {
                        "const": "EVIDENCE_REF_NOT_RESOLVED"
                      }
                    }
                  }

{
  "$defs": {
    "Coverage": {
      "enum": [
        "SUFFICIENT",
        "PARTIAL",
        "NONE",
        "UNKNOWN"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "DeliveryKind": {
      "enum": [
        "SYNC_HTTP",
        "ASYNC_MESSAGE"
      ],
      "title": "DeliveryKind",
      "type": "string"
    },
    "DeliveryRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SYNC_HTTP"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "relation_type": {
                "const": "CALLS"
              },
              "via": {
                "properties": {
                  "type": {
                    "const": "OPERATION"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "relation_type",
              "via"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ASYNC_MESSAGE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "relation_type": {
                "const": "SENDS"
              },
              "via": {
                "properties": {
                  "type": {
                    "const": "QUEUE"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "relation_type",
              "via"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/DeliveryKind"
        },
        "relation_type": {
          "$ref": "#/$defs/DeliveryRelationType"
        },
        "via": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "kind",
        "relation_type",
        "via"
      ],
      "title": "DeliveryRef",
      "type": "object"
    },
    "DeliveryRelationType": {
      "enum": [
        "CALLS",
        "SENDS"
      ],
      "title": "DeliveryRelationType",
      "type": "string"
    },
    "DependencyClaim": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "coverage": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "qualification": {
                "const": "NOT_OBSERVED_IN_WINDOW"
              }
            },
            "required": [
              "qualification"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "resolution_evidence_refs": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "destination_resolution": {
                "const": "RESOLVED_SERVICE"
              }
            },
            "required": [
              "destination_resolution"
            ]
          },
          "then": {
            "properties": {
              "resolution_evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "claim_id": {
          "pattern": "^aip:claim:v1:[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryRef"
        },
        "destination_resolution": {
          "$ref": "#/$defs/DestinationResolution"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "object": {
          "$ref": "#/$defs/EntityRef"
        },
        "predicate": {
          "$ref": "#/$defs/DependencyPredicate"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "resolution_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Resolution Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object",
        "destination_resolution",
        "delivery",
        "qualification",
        "coverage",
        "evidence_refs",
        "resolution_evidence_refs"
      ],
      "title": "DependencyClaim",
      "type": "object"
    },
    "DependencyPredicate": {
      "enum": [
        "DIRECT_DEPENDENCY"
      ],
      "title": "DependencyPredicate",
      "type": "string"
    },
    "DestinationResolution": {
      "enum": [
        "RESOLVED_SERVICE",
        "DIRECT_TARGET_FALLBACK"
      ],
      "title": "DestinationResolution",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "method": {
                "type": "null"
              },
              "path": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "OPERATION"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "namespace": {
                "type": "null"
              },
              "protocol": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "QUEUE"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        }
      },
      "required": [
        "id",
        "type",
        "name"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "SERVICE",
        "OPERATION",
        "QUEUE"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EvidenceData": {
      "additionalProperties": false,
      "description": "v0.4.0 I2.1 - spec \u00a711.2/\u00a712. `claims`/top-level `evidence_refs` on the enclosing\n`ArchitectureAnswer` stay empty for this tool - lookup creates no claim; resolved ids live here.",
      "properties": {
        "missing_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "records": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "requested_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Requested Evidence Refs",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "requested_evidence_refs",
        "records",
        "missing_evidence_refs"
      ],
      "title": "EvidenceData",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "observation": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "evidence_type": {
                "const": "OBSERVED"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "observation": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "description": "v0.4.0 I2.1 - spec \u00a711.2. `evidence_type`/`source_type` reuse the existing\n`app.provenance.model` enums rather than redefining them - no new adapter classification.",
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedEvidenceMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Locator"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Revision"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/SupportedFact"
          },
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "id",
        "evidence_type",
        "source_type",
        "source_locator",
        "source_revision",
        "observation",
        "supports"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceRelationType": {
      "description": "v0.4.0 I2.1 - the 7 canonical graph relation kinds (spec \u00a711.2's `supports`). Deliberately its\nown closed enum rather than reusing `DeliveryRelationType` (only CALLS/SENDS) or a graph-layer\nstring - `get_evidence` describes existing facts, never a new architecture claim.",
      "enum": [
        "PROVIDES",
        "CALLS",
        "SENDS",
        "RECEIVES_FROM",
        "CARRIES",
        "CONFORMS_TO",
        "DEAD_LETTERS_TO"
      ],
      "title": "EvidenceRelationType",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "DECLARED",
        "OBSERVED"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Limitation": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array",
          "uniqueItems": true
        },
        "code": {
          "$ref": "#/$defs/LimitationCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "LimitationCode": {
      "enum": [
        "UNRESOLVED_IDENTITY",
        "INSUFFICIENT_EVIDENCE",
        "UNKNOWN_ENTITY",
        "OBSERVATION_CONTEXT_REQUIRED",
        "SNAPSHOT_NOT_AVAILABLE",
        "RESULT_LIMIT_EXCEEDED"
      ],
      "title": "LimitationCode",
      "type": "string"
    },
    "ObservationContextRef": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "pattern": "^aip:observation-context:v1:[0-9a-f]{64}$",
          "title": "Context Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "environment",
        "window_start",
        "window_end"
      ],
      "title": "ObservationContextRef",
      "type": "object"
    },
    "ObservedEvidenceMetadata": {
      "additionalProperties": false,
      "description": "v0.4.0 I2.1 - spec \u00a711.2: bounded observed-evidence metadata only. No raw payloads,\nauthorization values, full spans, baggage, resource attributes, or sample trace ids.",
      "properties": {
        "bucket_end": {
          "format": "date-time",
          "title": "Bucket End",
          "type": "string"
        },
        "bucket_start": {
          "format": "date-time",
          "title": "Bucket Start",
          "type": "string"
        },
        "correlation_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Correlation Mode"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "observation_count": {
          "title": "Observation Count",
          "type": "integer"
        },
        "service_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Service Version"
        }
      },
      "required": [
        "environment",
        "bucket_start",
        "bucket_end",
        "first_seen",
        "last_seen",
        "observation_count",
        "service_version",
        "correlation_mode"
      ],
      "title": "ObservedEvidenceMetadata",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ANSWERED",
        "PARTIAL",
        "NOT_ANSWERED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "build_revision": {
          "title": "Build Revision",
          "type": "string"
        },
        "name": {
          "const": "architecture-intelligence-platform",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "build_revision"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Qualification": {
      "enum": [
        "CONFIRMED",
        "OBSERVED_ONLY",
        "NOT_OBSERVED_IN_WINDOW"
      ],
      "title": "Qualification",
      "type": "string"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Revision",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^aip:snapshot:v1:[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "model_revision"
      ],
      "title": "SnapshotRef",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "OPENAPI",
        "ASYNCAPI",
        "MANIFEST",
        "OPENTELEMETRY"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "SupportedFact": {
      "additionalProperties": false,
      "description": "v0.4.0 I2.1 - spec \u00a711.2: one existing canonical relation fact an evidence record supports.\nNot a generic graph record and not a new architecture claim - only the 3 bounded fields.",
      "properties": {
        "relation_type": {
          "$ref": "#/$defs/EvidenceRelationType"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "relation_type",
        "source_id",
        "target_id"
      ],
      "title": "SupportedFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ANSWERED",
              "PARTIAL"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_context": {
            "type": "null"
          },
          "tool": {
            "const": "get_service_dependencies"
          }
        },
        "required": [
          "observation_context",
          "tool"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "contains": {
              "properties": {
                "code": {
                  "const": "OBSERVATION_CONTEXT_REQUIRED"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        },
        "required": [
          "limitations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "get_evidence"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "maxItems": 0
          },
          "evidence_refs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "properties": {
        "tool": {
          "const": "get_evidence"
        }
      }
    }
  ],
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/DependencyClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceData"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/Limitation"
      },
      "title": "Limitations",
      "type": "array"
    },
    "observation_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationContextRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "const": "0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool": {
      "enum": [
        "get_service_dependencies",
        "get_evidence"
      ],
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "tool",
    "outcome",
    "snapshot",
    "observation_context",
    "data",
    "claims",
    "evidence_refs",
    "limitations"
  ],
  "title": "ArchitectureAnswer[EvidenceData]",
  "type": "object"
}

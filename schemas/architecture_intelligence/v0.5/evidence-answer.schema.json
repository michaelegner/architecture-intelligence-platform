{
  "$defs": {
    "Coverage": {
      "enum": [
        "SUFFICIENT",
        "PARTIAL",
        "NONE",
        "UNKNOWN"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "DeliveryKind": {
      "enum": [
        "SYNC_HTTP",
        "ASYNC_MESSAGE"
      ],
      "title": "DeliveryKind",
      "type": "string"
    },
    "DeliveryRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SYNC_HTTP"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "relation_type": {
                "const": "CALLS"
              },
              "via": {
                "properties": {
                  "type": {
                    "const": "OPERATION"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "relation_type",
              "via"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ASYNC_MESSAGE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "relation_type": {
                "enum": [
                  "PUBLISHES_TO",
                  "SENDS"
                ]
              }
            },
            "required": [
              "relation_type",
              "via"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "relation_type": {
                "const": "SENDS"
              }
            },
            "required": [
              "relation_type"
            ]
          },
          "then": {
            "properties": {
              "via": {
                "properties": {
                  "type": {
                    "const": "QUEUE"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "via"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "relation_type": {
                "const": "PUBLISHES_TO"
              }
            },
            "required": [
              "relation_type"
            ]
          },
          "then": {
            "properties": {
              "via": {
                "properties": {
                  "type": {
                    "const": "TOPIC"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "via"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "subscription": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "via": {
                "properties": {
                  "type": {
                    "const": "TOPIC"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "via"
            ]
          }
        },
        {
          "properties": {
            "subscription": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "properties": {
                    "type": {
                      "const": "SUBSCRIPTION"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/DeliveryKind"
        },
        "relation_type": {
          "$ref": "#/$defs/DeliveryRelationType"
        },
        "subscription": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "via": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "kind",
        "relation_type",
        "via"
      ],
      "title": "DeliveryRef",
      "type": "object"
    },
    "DeliveryRelationType": {
      "enum": [
        "CALLS",
        "SENDS",
        "PUBLISHES_TO"
      ],
      "title": "DeliveryRelationType",
      "type": "string"
    },
    "DependencyClaim": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "coverage": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "qualification": {
                "const": "NOT_OBSERVED_IN_WINDOW"
              }
            },
            "required": [
              "qualification"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "resolution_evidence_refs": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "destination_resolution": {
                "const": "RESOLVED_SERVICE"
              }
            },
            "required": [
              "destination_resolution"
            ]
          },
          "then": {
            "properties": {
              "resolution_evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "properties": {
            "object": {
              "properties": {
                "type": {
                  "not": {
                    "const": "WORKLOAD"
                  }
                }
              }
            },
            "subject": {
              "properties": {
                "type": {
                  "const": "SERVICE"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "claim_id": {
          "pattern": "^aip:claim:v1:[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryRef"
        },
        "destination_resolution": {
          "$ref": "#/$defs/DestinationResolution"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "object": {
          "$ref": "#/$defs/EntityRef"
        },
        "predicate": {
          "const": "DIRECT_DEPENDENCY",
          "title": "Predicate",
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "resolution_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Resolution Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object",
        "destination_resolution",
        "delivery",
        "qualification",
        "coverage",
        "evidence_refs",
        "resolution_evidence_refs"
      ],
      "title": "DependencyClaim",
      "type": "object"
    },
    "DeploymentClaim": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "supporting_methods": {
                "prefixItems": [
                  {
                    "const": "RESOLVED_EXPLICIT"
                  }
                ]
              }
            },
            "required": [
              "supporting_methods"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "RESOLVED_EXPLICIT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supporting_methods": {
                "prefixItems": [
                  {
                    "const": "RESOLVED_CONFIGURED"
                  }
                ]
              }
            },
            "required": [
              "supporting_methods"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "RESOLVED_CONFIGURED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supporting_methods": {
                "prefixItems": [
                  {
                    "const": "RESOLVED_OBSERVED"
                  }
                ]
              }
            },
            "required": [
              "supporting_methods"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "RESOLVED_OBSERVED"
              }
            }
          }
        },
        {
          "properties": {
            "subject": {
              "properties": {
                "type": {
                  "const": "SERVICE"
                }
              }
            }
          }
        }
      ],
      "description": "I3 spec \u00a712: the public `Service -[DEPLOYED_AS]-> Workload` claim. Deliberately has no\n`delivery`/`qualification`/`coverage`/`destination_resolution` fields - those are\n`DependencyClaim`-only concepts describing a CALLS/SENDS interaction, and `DEPLOYED_AS` is never\nan interaction (spec \u00a71: \"DEPLOYED_AS != CALLS != SENDS != RECEIVES_FROM\").",
      "properties": {
        "claim_id": {
          "pattern": "^aip:claim:v1:[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "object": {
          "$ref": "#/$defs/WorkloadRef"
        },
        "predicate": {
          "const": "DEPLOYED_AS",
          "title": "Predicate",
          "type": "string"
        },
        "reconciliation_rule_id": {
          "const": "service-workload-reconciliation",
          "title": "Reconciliation Rule Id",
          "type": "string"
        },
        "reconciliation_rule_version": {
          "const": 1,
          "title": "Reconciliation Rule Version",
          "type": "integer"
        },
        "resolution_method": {
          "$ref": "#/$defs/DeploymentResolutionMethod"
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        },
        "supporting_methods": {
          "items": {
            "$ref": "#/$defs/DeploymentResolutionMethod"
          },
          "minItems": 1,
          "title": "Supporting Methods",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object",
        "resolution_method",
        "supporting_methods",
        "reconciliation_rule_id",
        "reconciliation_rule_version",
        "evidence_refs"
      ],
      "title": "DeploymentClaim",
      "type": "object"
    },
    "DeploymentResolutionMethod": {
      "description": "I3 spec \u00a710.1: only the three *successful* identity-path outcomes - never CONFLICT/\nAMBIGUOUS/UNRESOLVED, which are never a \"method\" a claim can be supported by. Compare\n`DeploymentResolutionStatus` below, which is the wider 6-value outcome set a\n`DeploymentResolution` (as opposed to an actual `DeploymentClaim`) may carry.",
      "enum": [
        "RESOLVED_EXPLICIT",
        "RESOLVED_CONFIGURED",
        "RESOLVED_OBSERVED"
      ],
      "title": "DeploymentResolutionMethod",
      "type": "string"
    },
    "DestinationResolution": {
      "enum": [
        "RESOLVED_SERVICE",
        "DIRECT_TARGET_FALLBACK"
      ],
      "title": "DestinationResolution",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "method": {
                "type": "null"
              },
              "path": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "OPERATION"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "namespace": {
                "type": "null"
              },
              "protocol": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "QUEUE",
                  "SUBSCRIPTION",
                  "TOPIC"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        }
      },
      "required": [
        "id",
        "type",
        "name"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "SERVICE",
        "OPERATION",
        "QUEUE",
        "WORKLOAD",
        "TOPIC",
        "SUBSCRIPTION"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EvidenceData": {
      "additionalProperties": false,
      "description": "v0.4.0 I2.1 - spec \u00a711.2/\u00a712. `claims`/top-level `evidence_refs` on the enclosing\n`ArchitectureAnswer` stay empty for this tool - lookup creates no claim; resolved ids live here.",
      "properties": {
        "missing_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "records": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "requested_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Requested Evidence Refs",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "requested_evidence_refs",
        "records",
        "missing_evidence_refs"
      ],
      "title": "EvidenceData",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "observation": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "evidence_type": {
                "const": "OBSERVED"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "observation": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "description": "v0.4.0 I2.1 - spec \u00a711.2. `evidence_type`/`source_type` reuse the existing\n`app.provenance.model` enums rather than redefining them - no new adapter classification.",
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedEvidenceMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Locator"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Revision"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/SupportedFact"
          },
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "id",
        "evidence_type",
        "source_type",
        "source_locator",
        "source_revision",
        "observation",
        "supports"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceRelationType": {
      "description": "v0.4.0 I2.1 - the closed set of canonical graph relation kinds (spec \u00a711.2's `supports`),\nwidened by I3 (DEPLOYED_AS) and v0.5.0 I4 (PUBLISHES_TO/SUBSCRIPTION_OF). Deliberately its own\nclosed enum rather than reusing `DeliveryRelationType` (only the delivery relations) or a\ngraph-layer string - `get_evidence` describes existing facts, never a new architecture claim.",
      "enum": [
        "PROVIDES",
        "CALLS",
        "SENDS",
        "RECEIVES_FROM",
        "CARRIES",
        "CONFORMS_TO",
        "DEAD_LETTERS_TO",
        "DEPLOYED_AS",
        "PUBLISHES_TO",
        "SUBSCRIPTION_OF"
      ],
      "title": "EvidenceRelationType",
      "type": "string"
    },
    "EvidenceType": {
      "enum": [
        "DECLARED",
        "OBSERVED"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Limitation": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array",
          "uniqueItems": true
        },
        "code": {
          "$ref": "#/$defs/LimitationCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "LimitationCode": {
      "enum": [
        "UNRESOLVED_IDENTITY",
        "INSUFFICIENT_EVIDENCE",
        "UNKNOWN_ENTITY",
        "OBSERVATION_CONTEXT_REQUIRED",
        "SNAPSHOT_NOT_AVAILABLE",
        "RESULT_LIMIT_EXCEEDED",
        "DEPLOYMENT_IDENTITY_UNRESOLVED",
        "DEPLOYMENT_IDENTITY_AMBIGUOUS",
        "DEPLOYMENT_IDENTITY_CONFLICT",
        "DEPLOYMENT_ENVIRONMENT_MISMATCH",
        "DEPLOYMENT_TEMPORAL_MISMATCH",
        "DEPLOYMENT_EVIDENCE_INCOMPLETE",
        "DEPLOYMENT_RESULT_LIMIT_EXCEEDED"
      ],
      "title": "LimitationCode",
      "type": "string"
    },
    "ObservationContextRef": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "pattern": "^aip:observation-context:v1:[0-9a-f]{64}$",
          "title": "Context Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "environment",
        "window_start",
        "window_end"
      ],
      "title": "ObservationContextRef",
      "type": "object"
    },
    "ObservedEvidenceMetadata": {
      "additionalProperties": false,
      "description": "v0.4.0 I2.1 - spec \u00a711.2: bounded observed-evidence metadata only. No raw payloads,\nauthorization values, full spans, baggage, resource attributes, or sample trace ids.",
      "properties": {
        "bucket_end": {
          "format": "date-time",
          "title": "Bucket End",
          "type": "string"
        },
        "bucket_start": {
          "format": "date-time",
          "title": "Bucket Start",
          "type": "string"
        },
        "correlation_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Correlation Mode"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "observation_count": {
          "title": "Observation Count",
          "type": "integer"
        },
        "service_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Service Version"
        }
      },
      "required": [
        "environment",
        "bucket_start",
        "bucket_end",
        "first_seen",
        "last_seen",
        "observation_count",
        "service_version",
        "correlation_mode"
      ],
      "title": "ObservedEvidenceMetadata",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ANSWERED",
        "PARTIAL",
        "NOT_ANSWERED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "build_revision": {
          "title": "Build Revision",
          "type": "string"
        },
        "name": {
          "const": "architecture-intelligence-platform",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "build_revision"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Qualification": {
      "enum": [
        "CONFIRMED",
        "OBSERVED_ONLY",
        "NOT_OBSERVED_IN_WINDOW"
      ],
      "title": "Qualification",
      "type": "string"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Revision",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^aip:snapshot:v1:[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "model_revision"
      ],
      "title": "SnapshotRef",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "OPENAPI",
        "ASYNCAPI",
        "MANIFEST",
        "OPENTELEMETRY",
        "KUBERNETES",
        "CONFIGURATION"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "SupportedFact": {
      "additionalProperties": false,
      "description": "v0.4.0 I2.1 - spec \u00a711.2: one existing canonical relation fact an evidence record supports.\nNot a generic graph record and not a new architecture claim - only the 3 bounded fields.",
      "properties": {
        "relation_type": {
          "$ref": "#/$defs/EvidenceRelationType"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },

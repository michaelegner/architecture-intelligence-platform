            "maxItems": 0
          },
          "evidence_refs": {
            "maxItems": 0
          },
          "observation_context": {
            "type": "null"
          }
        }
      }
    },
    {
      "properties": {
        "tool": {
          "const": "get_evidence"
        }
      }
    }
  ],
  "properties": {

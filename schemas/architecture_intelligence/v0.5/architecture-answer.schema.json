{
  "$defs": {
    "Coverage": {
      "enum": [
        "SUFFICIENT",
        "PARTIAL",
        "NONE",
        "UNKNOWN"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "DeliveryKind": {
      "enum": [
        "SYNC_HTTP",
        "ASYNC_MESSAGE"
      ],
      "title": "DeliveryKind",
      "type": "string"
    },
    "DeliveryRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SYNC_HTTP"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "relation_type": {
                "const": "CALLS"
              },
              "via": {
                "properties": {
                  "type": {
                    "const": "OPERATION"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "relation_type",
              "via"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ASYNC_MESSAGE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "relation_type": {
                "const": "SENDS"
              },
              "via": {
                "properties": {
                  "type": {
                    "const": "QUEUE"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "relation_type",
              "via"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/DeliveryKind"
        },
        "relation_type": {
          "$ref": "#/$defs/DeliveryRelationType"
        },
        "via": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "kind",
        "relation_type",
        "via"
      ],
      "title": "DeliveryRef",
      "type": "object"
    },
    "DeliveryRelationType": {
      "enum": [
        "CALLS",
        "SENDS"
      ],
      "title": "DeliveryRelationType",
      "type": "string"
    },
    "DependencyClaim": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "coverage": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "qualification": {
                "const": "NOT_OBSERVED_IN_WINDOW"
              }
            },
            "required": [
              "qualification"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "resolution_evidence_refs": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "destination_resolution": {
                "const": "RESOLVED_SERVICE"
              }
            },
            "required": [
              "destination_resolution"
            ]
          },
          "then": {
            "properties": {
              "resolution_evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "properties": {
            "object": {
              "properties": {
                "type": {
                  "not": {
                    "const": "WORKLOAD"
                  }
                }
              }
            },
            "subject": {
              "properties": {
                "type": {
                  "const": "SERVICE"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "claim_id": {
          "pattern": "^aip:claim:v1:[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryRef"
        },
        "destination_resolution": {
          "$ref": "#/$defs/DestinationResolution"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "object": {
          "$ref": "#/$defs/EntityRef"
        },
        "predicate": {
          "const": "DIRECT_DEPENDENCY",
          "default": "DIRECT_DEPENDENCY",
          "title": "Predicate",
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "resolution_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Resolution Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "object",
        "destination_resolution",
        "delivery",
        "qualification",
        "coverage",
        "evidence_refs",
        "resolution_evidence_refs"
      ],
      "title": "DependencyClaim",
      "type": "object"
    },
    "DeploymentClaim": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "supporting_methods": {
                "prefixItems": [
                  {
                    "const": "RESOLVED_EXPLICIT"
                  }
                ]
              }
            },
            "required": [
              "supporting_methods"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "RESOLVED_EXPLICIT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supporting_methods": {
                "prefixItems": [
                  {
                    "const": "RESOLVED_CONFIGURED"
                  }
                ]
              }
            },
            "required": [
              "supporting_methods"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "RESOLVED_CONFIGURED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supporting_methods": {
                "prefixItems": [
                  {
                    "const": "RESOLVED_OBSERVED"
                  }
                ]
              }
            },
            "required": [
              "supporting_methods"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "RESOLVED_OBSERVED"
              }
            }
          }
        }
      ],
      "description": "I3 spec \u00a712: the public `Service -[DEPLOYED_AS]-> Workload` claim. Deliberately has no\n`delivery`/`qualification`/`coverage`/`destination_resolution` fields - those are\n`DependencyClaim`-only concepts describing a CALLS/SENDS interaction, and `DEPLOYED_AS` is never\nan interaction (spec \u00a71: \"DEPLOYED_AS != CALLS != SENDS != RECEIVES_FROM\").",
      "properties": {
        "claim_id": {
          "pattern": "^aip:claim:v1:[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "object": {
          "$ref": "#/$defs/WorkloadRef"
        },
        "predicate": {
          "const": "DEPLOYED_AS",
          "default": "DEPLOYED_AS",
          "title": "Predicate",
          "type": "string"
        },
        "reconciliation_rule_id": {
          "const": "service-workload-reconciliation",
          "default": "service-workload-reconciliation",
          "title": "Reconciliation Rule Id",
          "type": "string"
        },
        "reconciliation_rule_version": {
          "const": 1,
          "default": 1,
          "title": "Reconciliation Rule Version",
          "type": "integer"
        },
        "resolution_method": {
          "$ref": "#/$defs/DeploymentResolutionMethod"
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        },
        "supporting_methods": {
          "items": {
            "$ref": "#/$defs/DeploymentResolutionMethod"
          },
          "minItems": 1,
          "title": "Supporting Methods",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "subject",
        "object",
        "resolution_method",
        "supporting_methods",
        "evidence_refs"
      ],
      "title": "DeploymentClaim",
      "type": "object"
    },
    "DeploymentResolution": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "claim_id": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "pattern": "^RESOLVED_"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "claim_id": {
                "not": {
                  "type": "null"
                }
              },
              "service_id": {
                "not": {
                  "type": "null"
                }
              },
              "supporting_methods": {
                "minItems": 1
              },
              "workload": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "description": "I3 spec \u00a713.3: the public resolution-outcome shape, returned for every reconciliation\ncandidate group whether it produced a claim or not - \"Resolved and non-resolved outcomes SHALL\nbe inspectable without fabricating a claim.\" ",
      "properties": {
        "candidate_service_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Service Ids",
          "type": "array",
          "uniqueItems": true
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Claim Id"
        },
        "conflicting_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "limitation_codes": {
          "items": {
            "$ref": "#/$defs/LimitationCode"
          },
          "title": "Limitation Codes",
          "type": "array",
          "uniqueItems": true
        },
        "reconciliation_rule_id": {
          "const": "service-workload-reconciliation",
          "default": "service-workload-reconciliation",
          "title": "Reconciliation Rule Id",
          "type": "string"
        },
        "reconciliation_rule_version": {
          "const": 1,
          "default": 1,
          "title": "Reconciliation Rule Version",
          "type": "integer"
        },
        "resolution_id": {
          "pattern": "^aip:deployment-resolution:v1:[0-9a-f]{64}$",
          "title": "Resolution Id",
          "type": "string"
        },
        "service_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Service Id"
        },
        "status": {
          "$ref": "#/$defs/DeploymentResolutionStatus"
        },
        "supporting_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "supporting_methods": {
          "items": {
            "$ref": "#/$defs/DeploymentResolutionMethod"
          },
          "title": "Supporting Methods",
          "type": "array",
          "uniqueItems": true
        },
        "workload": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkloadRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resolution_id",
        "workload",
        "status",
        "service_id",
        "candidate_service_ids",
        "supporting_methods",
        "supporting_evidence_refs",
        "conflicting_evidence_refs",
        "limitation_codes",
        "claim_id"
      ],
      "title": "DeploymentResolution",
      "type": "object"
    },
    "DeploymentResolutionMethod": {
      "description": "I3 spec \u00a710.1: only the three *successful* identity-path outcomes - never CONFLICT/\nAMBIGUOUS/UNRESOLVED, which are never a \"method\" a claim can be supported by. Compare\n`DeploymentResolutionStatus` below, which is the wider 6-value outcome set a\n`DeploymentResolution` (as opposed to an actual `DeploymentClaim`) may carry.",
      "enum": [
        "RESOLVED_EXPLICIT",
        "RESOLVED_CONFIGURED",
        "RESOLVED_OBSERVED"
      ],
      "title": "DeploymentResolutionMethod",
      "type": "string"
    },
    "DeploymentResolutionStatus": {
      "description": "I3 spec \u00a713.3: the wider 6-value outcome set a `DeploymentResolution` may carry - the three\nsuccessful `DeploymentResolutionMethod` values plus the three non-resolved outcomes. Kept as its\nown enum (not reusing `DeploymentResolutionMethod`) since CONFLICT/AMBIGUOUS/UNRESOLVED are never\nvalid `DeploymentClaim.resolution_method`/`.supporting_methods` values (spec \u00a710.1: \"Similarity is\nnever a successful path\" - and conflict/ambiguity are never \"methods\" either).",
      "enum": [
        "RESOLVED_EXPLICIT",
        "RESOLVED_CONFIGURED",
        "RESOLVED_OBSERVED",
        "CONFLICT",
        "AMBIGUOUS",
        "UNRESOLVED"
      ],
      "title": "DeploymentResolutionStatus",
      "type": "string"
    },
    "DestinationResolution": {
      "enum": [
        "RESOLVED_SERVICE",
        "DIRECT_TARGET_FALLBACK"
      ],
      "title": "DestinationResolution",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "method": {
                "type": "null"
              },
              "path": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "OPERATION"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "namespace": {
                "type": "null"
              },
              "protocol": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "QUEUE"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "type": {
          "$ref": "#/$defs/EntityType"
        }
      },
      "required": [
        "id",
        "type",
        "name"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "SERVICE",
        "OPERATION",
        "QUEUE",
        "WORKLOAD"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "Limitation": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array",
          "uniqueItems": true
        },
        "code": {
          "$ref": "#/$defs/LimitationCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "LimitationCode": {
      "enum": [
        "UNRESOLVED_IDENTITY",
        "INSUFFICIENT_EVIDENCE",
        "UNKNOWN_ENTITY",
        "OBSERVATION_CONTEXT_REQUIRED",
        "SNAPSHOT_NOT_AVAILABLE",
        "RESULT_LIMIT_EXCEEDED",
        "DEPLOYMENT_IDENTITY_UNRESOLVED",
        "DEPLOYMENT_IDENTITY_AMBIGUOUS",
        "DEPLOYMENT_IDENTITY_CONFLICT",
        "DEPLOYMENT_ENVIRONMENT_MISMATCH",
        "DEPLOYMENT_TEMPORAL_MISMATCH",
        "DEPLOYMENT_EVIDENCE_INCOMPLETE",
        "DEPLOYMENT_RESULT_LIMIT_EXCEEDED"
      ],
      "title": "LimitationCode",
      "type": "string"
    },
    "ObservationContextRef": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "pattern": "^aip:observation-context:v1:[0-9a-f]{64}$",
          "title": "Context Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "environment",
        "window_start",
        "window_end"
      ],
      "title": "ObservationContextRef",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ANSWERED",
        "PARTIAL",
        "NOT_ANSWERED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "build_revision": {
          "title": "Build Revision",
          "type": "string"
        },
        "name": {
          "const": "architecture-intelligence-platform",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "build_revision"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Qualification": {
      "enum": [
        "CONFIRMED",
        "OBSERVED_ONLY",
        "NOT_OBSERVED_IN_WINDOW"
      ],
      "title": "Qualification",
      "type": "string"
    },
    "ServiceDependenciesData": {
      "additionalProperties": false,
      "description": "v0.5.0 I3 spec \u00a714.2: deployment is a separate sibling projection, never a dependency -\n`deployment_claim_ids`/`deployment_resolutions` are additive fields alongside the original\ndependency-only shape, not a replacement of it.",
      "properties": {
        "dependency_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Claim Ids",
          "type": "array"
        },
        "deployment_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Deployment Claim Ids",
          "type": "array"
        },
        "deployment_resolutions": {
          "items": {
            "$ref": "#/$defs/DeploymentResolution"
          },
          "title": "Deployment Resolutions",
          "type": "array"
        },
        "service": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "service",
        "dependency_claim_ids",
        "deployment_claim_ids",
        "deployment_resolutions"
      ],
      "title": "ServiceDependenciesData",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Revision",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^aip:snapshot:v1:[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "model_revision"
      ],
      "title": "SnapshotRef",
      "type": "object"
    },
    "WorkloadKind": {
      "description": "I3 spec \u00a78.1: the exact supported Kubernetes controller kinds a deployment identity path may\nresolve to - the same closed set I2's own owner-chain resolution already admits.",
      "enum": [
        "DEPLOYMENT",
        "STATEFULSET",
        "DAEMONSET"
      ],
      "title": "WorkloadKind",
      "type": "string"
    },
    "WorkloadRef": {
      "additionalProperties": false,
      "description": "I3 spec \u00a711: a bounded public Workload reference, deliberately its own model rather than an\n`EntityRef` extension. `EntityRef` is reused by `DependencyClaim.subject`/`.object` and\n`DeliveryRef.via` - widening its type-specific-field validator with a WORKLOAD branch would make\na Workload-shaped `EntityRef` constructible inside a dependency claim, exactly the governing\n\"DEPLOYED_AS != CALLS\" / entity-equivalence boundary spec \u00a71 forbids. `DeploymentClaim.object` is\ntyped `WorkloadRef`, never `EntityRef`, for the same reason.\n\nCluster UID, Pod UID, source inventory, resource UID, and owner-chain details remain evidence\ndrill-down, not fields of this relation target (spec \u00a711's own rule) - `namespace` here is\nidentity context, not a locality qualification.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "type": {
          "const": "WORKLOAD",
          "default": "WORKLOAD",
          "title": "Type",
          "type": "string"
        },
        "workload_kind": {
          "$ref": "#/$defs/WorkloadKind"
        }
      },
      "required": [
        "id",
        "name",
        "workload_kind",
        "namespace"
      ],
      "title": "WorkloadRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ANSWERED",
              "PARTIAL"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_context": {
            "type": "null"
          },
          "tool": {
            "enum": [
              "get_architecture_drift",
              "get_service_dependencies"
            ]
          }
        },
        "required": [
          "observation_context",
          "tool"
        ]
      },
      "then": {
        "properties": {

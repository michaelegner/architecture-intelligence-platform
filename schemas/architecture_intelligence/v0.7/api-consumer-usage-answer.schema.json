{
  "$defs": {
    "ApiConsumerUsageData": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "request_context": {
                "properties": {
                  "target": {
                    "properties": {
                      "kind": {
                        "const": "GATEWAY_ROUTE"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "request_context"
            ]
          },
          "then": {
            "not": {
              "required": [
                "association_summary"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "request_context": {
                "properties": {
                  "target": {
                    "properties": {
                      "kind": {
                        "const": "API_OPERATION"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "request_context"
            ]
          },
          "then": {
            "properties": {
              "association_summary": {
                "required": [
                  "route_operation"
                ]
              }
            },
            "required": [
              "association_summary"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "request_context": {
                "properties": {
                  "target": {
                    "properties": {
                      "kind": {
                        "const": "APPLICATION_SERVICE"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "request_context"
            ]
          },
          "then": {
            "properties": {
              "association_summary": {
                "required": [
                  "target_service"
                ]
              }
            },
            "required": [
              "association_summary"
            ]
          }
        }
      ],
      "description": "D4: the `mode: \"query\"` payload.",
      "properties": {
        "association_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssociationSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "configuration_sources": {
          "items": {
            "$ref": "#/$defs/ConfigurationSource"
          },
          "title": "Configuration Sources",
          "type": "array",
          "uniqueItems": true
        },
        "measurement_sources": {
          "items": {
            "$ref": "#/$defs/MeasurementSource"
          },
          "minItems": 1,
          "title": "Measurement Sources",
          "type": "array",
          "uniqueItems": true
        },
        "page": {
          "$ref": "#/$defs/Page"
        },
        "request_context": {
          "$ref": "#/$defs/ApiUsageRequestContext"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ApiUsageRow"
          },
          "maxItems": 200,
          "title": "Rows",
          "type": "array",
          "uniqueItems": true
        },
        "rules": {
          "$ref": "#/$defs/Rules"
        },
        "selected_routes": {
          "items": {
            "$ref": "#/$defs/SelectedRoute"
          },
          "title": "Selected Routes",
          "type": "array",
          "uniqueItems": true
        },
        "window": {
          "$ref": "#/$defs/ApiUsageWindow"
        }
      },
      "required": [
        "request_context",
        "window",
        "rules",
        "selected_routes",
        "configuration_sources",
        "measurement_sources",
        "rows",
        "page"
      ],
      "title": "ApiConsumerUsageData",
      "type": "object"
    },
    "ApiConsumerUsageEvidenceData": {
      "additionalProperties": false,
      "description": "D9: the `mode: \"evidence\"` payload, one entry per requested ref, sorted by ref.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/EvidenceEntry"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Entries",
          "type": "array",
          "uniqueItems": true
        },
        "request_context": {
          "$ref": "#/$defs/ApiUsageRequestContext"
        }
      },
      "required": [
        "request_context",
        "entries"
      ],
      "title": "ApiConsumerUsageEvidenceData",
      "type": "object"
    },
    "ApiUsageLimitation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ApiUsageLimitationCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiUsageLimitation",
      "type": "object"
    },
    "ApiUsageLimitationCode": {
      "description": "D6: the closed 0.7 envelope codes, separate from the 0.5 `LimitationCode` and the 0.6\nlocality enum. The first five are refusal codes.",
      "enum": [
        "SNAPSHOT_NOT_AVAILABLE",
        "MEASUREMENT_WINDOW_NOT_AVAILABLE",
        "UNKNOWN_TARGET",
        "TARGET_NOT_IN_WINDOW_SCOPE",
        "CURSOR_QUERY_MISMATCH",
        "NO_ROUTE_SELECTED",
        "MORE_ROWS_AVAILABLE",
        "WINDOW_NOT_VALID",
        "COVERAGE_UNKNOWN",
        "EVIDENCE_REF_NOT_RESOLVED"
      ],
      "title": "ApiUsageLimitationCode",
      "type": "string"
    },
    "ApiUsageRequestContext": {
      "additionalProperties": false,
      "description": "D4: the normalized query context (without `limit`, `cursor` and `snapshot_id`).",
      "properties": {
        "consumer_id": {
          "anyOf": [
            {
              "pattern": "^gateway-consumer:owned:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumer Id"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "gateway_instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Gateway Instance Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ApiUsageTarget"
        },
        "window_end": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "target",
        "gateway_instance_id",
        "environment",
        "window_start",
        "window_end"
      ],
      "title": "ApiUsageRequestContext",
      "type": "object"
    },
    "ApiUsageRow": {
      "additionalProperties": false,
      "description": "D4: one I2 `qualification_rows` entry, enriched only with same-snapshot reconciliation.",
      "properties": {
        "api": {
          "$ref": "#/$defs/RowApi"
        },
        "application_service": {
          "$ref": "#/$defs/RowService"
        },
        "configured_access": {
          "$ref": "#/$defs/RowConfiguredAccess"
        },
        "consumer": {
          "$ref": "#/$defs/RowConsumer"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^api-evidence:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "gateway_route": {
          "$ref": "#/$defs/RowRoute"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/MeasurementCode"
          },
          "title": "Limitations",
          "type": "array",
          "uniqueItems": true
        },
        "usage": {
          "$ref": "#/$defs/RowUsage"
        }
      },
      "required": [
        "consumer",
        "gateway_route",
        "api",
        "application_service",
        "configured_access",
        "usage",
        "evidence_refs",
        "limitations"
      ],
      "title": "ApiUsageRow",
      "type": "object"
    },
    "ApiUsageTarget": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "APPLICATION_SERVICE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^service:[^\\s\\x00-\\x1f\\x7f]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "API_OPERATION"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^operation:[^\\s\\x00-\\x1f\\x7f]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "GATEWAY_ROUTE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^gateway-route:owned:[0-9a-f]{64}$"
              }
            }
          }
        }
      ],
      "description": "D3: exactly one exact target. The id pattern depends on the kind; never a display name, path\nor host.",
      "properties": {
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "ApiUsageTarget",
      "type": "object"
    },
    "ApiUsageWindow": {
      "additionalProperties": false,
      "description": "D4: the I2 window the answer is about. `valid` is true iff there are no reasons.",
      "properties": {
        "evidence_refs": {
          "items": {
            "pattern": "^api-evidence:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/WindowReasonCode"
          },
          "title": "Reasons",
          "type": "array",
          "uniqueItems": true
        },
        "source_instance_id": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Source Instance Id",
          "type": "string"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "window_end": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "window_start",
        "window_end",
        "source_instance_id",
        "valid",
        "reasons",
        "evidence_refs"
      ],
      "title": "ApiUsageWindow",
      "type": "object"
    },
    "AssociationCounts": {
      "additionalProperties": false,
      "description": "I3 \u00a75.2/\u00a75.3: all GatewayRoutes of the selected scope by the I2 outcome of one chain.",
      "properties": {
        "ambiguous": {
          "minimum": 0,
          "title": "Ambiguous",
          "type": "integer"
        },
        "conflict": {
          "minimum": 0,
          "title": "Conflict",
          "type": "integer"
        },
        "resolved_elsewhere": {
          "minimum": 0,
          "title": "Resolved Elsewhere",
          "type": "integer"
        },
        "resolved_to_target": {
          "minimum": 0,
          "title": "Resolved To Target",
          "type": "integer"
        },
        "unresolved": {
          "minimum": 0,
          "title": "Unresolved",
          "type": "integer"
        }
      },
      "required": [
        "resolved_to_target",
        "resolved_elsewhere",
        "unresolved",
        "ambiguous",
        "conflict"
      ],
      "title": "AssociationCounts",
      "type": "object"
    },
    "AssociationSummary": {
      "additionalProperties": false,
      "description": "Exactly one chain: `route_operation` for an `API_OPERATION` target, `target_service` for an\n`APPLICATION_SERVICE` target. Informational only.",
      "properties": {
        "route_operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssociationCounts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_service": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssociationCounts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AssociationSummary",
      "type": "object"
    },
    "ConfigurationSource": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "gateway_instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Gateway Instance Id",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "gateway_instance_id",
        "environment",
        "source_revision"
      ],
      "title": "ConfigurationSource",
      "type": "object"
    },
    "ConfiguredAccessEvidence": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "$ref": "#/$defs/RowConsumer"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "gateway_instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Gateway Instance Id",
          "type": "string"
        },
        "gateway_route": {
          "$ref": "#/$defs/EvidenceRoute"
        },
        "kind": {
          "const": "CONFIGURED_ACCESS",
          "title": "Kind",
          "type": "string"
        },
        "polarity": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Polarity",
          "type": "string"
        },
        "rule_kind": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Rule Kind",
          "type": "string"
        },
        "scope": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Scope",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "gateway_instance_id",
        "environment",
        "source_revision",
        "consumer",
        "gateway_route",
        "rule_kind",
        "polarity",
        "scope"
      ],
      "title": "ConfiguredAccessEvidence",
      "type": "object"
    },
    "ConfiguredAccessStatus": {
      "enum": [
        "CONFIGURED_ACCESS_ESTABLISHED",
        "NO_MATCHING_CONFIGURED_ACCESS_FACT"
      ],
      "title": "ConfiguredAccessStatus",
      "type": "string"
    },
    "Coverage": {
      "enum": [
        "SUFFICIENT_FOR_ZERO",
        "UNKNOWN_COVERAGE"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "EvidenceEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "kind"
                  ]
                },
                {
                  "required": [
                    "evidence"
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "kind",
              "evidence"
            ]
          }
        }
      ],
      "description": "D9: one requested ref. A forged, cross-snapshot and cross-context ref are all simply\n`NOT_RESOLVED` and indistinguishable (no ref history is kept).",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "CONFIGURED_ACCESS": "#/$defs/ConfiguredAccessEvidence",
                  "MEASUREMENT_WINDOW": "#/$defs/MeasurementWindowEvidence",
                  "QUALIFICATION_LIMITATIONS": "#/$defs/QualificationLimitationsEvidence",
                  "ROUTE_OPERATION_RECONCILIATION": "#/$defs/RouteOperationReconciliationEvidence",
                  "TARGET_SERVICE_RECONCILIATION": "#/$defs/TargetServiceReconciliationEvidence"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConfiguredAccessEvidence"
                },
                {
                  "$ref": "#/$defs/MeasurementWindowEvidence"
                },
                {
                  "$ref": "#/$defs/RouteOperationReconciliationEvidence"
                },
                {
                  "$ref": "#/$defs/TargetServiceReconciliationEvidence"
                },
                {
                  "$ref": "#/$defs/QualificationLimitationsEvidence"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "pattern": "^api-evidence:[0-9a-f]{64}$",
          "title": "Ref",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "ref",
        "status"
      ],
      "title": "EvidenceEntry",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "CONFIGURED_ACCESS",
        "MEASUREMENT_WINDOW",
        "ROUTE_OPERATION_RECONCILIATION",
        "TARGET_SERVICE_RECONCILIATION",
        "QUALIFICATION_LIMITATIONS"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRoute": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^gateway-route:owned:[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "source_route_id": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Source Route Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_route_id"
      ],
      "title": "EvidenceRoute",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "RESOLVED",
        "NOT_RESOLVED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ExtractDigests": {
      "additionalProperties": false,
      "properties": {
        "end_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "End Sha256",
          "type": "string"
        },
        "start_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Start Sha256",
          "type": "string"
        }
      },
      "required": [
        "start_sha256",
        "end_sha256"
      ],
      "title": "ExtractDigests",
      "type": "object"
    },
    "MeasurementCode": {
      "description": "Every I2 limitation code a Route or row can carry: the window reasons and the route-level\ncoverage codes (contract \u00a77).",
      "enum": [
        "GWM_WINDOW_NOT_SETTLED",
        "GWM_WINDOW_RESTART",
        "GWM_WINDOW_ORDER_INVALID",
        "GWM_VERSION_INCOMPATIBLE",
        "GWM_CONSUMER_LABEL_DISABLED",
        "GWM_ROUTE_COVERAGE_ABSENT",
        "GWM_ROUTE_PROMETHEUS_DISABLED",
        "GWM_COUNTER_DECREASED",
        "GWM_SERIES_ONE_BOUNDARY",
        "GWM_UNATTRIBUTED_UPSTREAM"
      ],
      "title": "MeasurementCode",
      "type": "string"
    },
    "MeasurementSource": {
      "additionalProperties": false,
      "properties": {
        "apisix_version": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Apisix Version",
          "type": "string"
        },
        "source_instance_id": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Source Instance Id",
          "type": "string"
        },
        "window_end": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "source_instance_id",
        "window_start",
        "window_end",
        "apisix_version"
      ],
      "title": "MeasurementSource",
      "type": "object"
    },
    "MeasurementWindowEvidence": {
      "additionalProperties": false,
      "properties": {
        "apisix_version": {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Apisix Version",
          "type": "string"
        },
        "end_settled": {
          "title": "End Settled",
          "type": "boolean"
        },
        "end_stable_seconds": {
          "minimum": 0,
          "title": "End Stable Seconds",
          "type": "integer"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Environment",
          "type": "string"
        },
        "evidence_type": {
          "const": "OBSERVED",
          "title": "Evidence Type",

              }
            ]
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "limitations": {
            "items": {
              "properties": {
                "code": {
                  "not": {
                    "enum": [
                      "CURSOR_QUERY_MISMATCH",
                      "MEASUREMENT_WINDOW_NOT_AVAILABLE",
                      "SNAPSHOT_NOT_AVAILABLE",
                      "TARGET_NOT_IN_WINDOW_SCOPE",
                      "UNKNOWN_TARGET"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "data": {
            "type": "null"
          }
        },
        "required": [
          "data"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "items": {
              "properties": {
                "code": {
                  "enum": [
                    "CURSOR_QUERY_MISMATCH",
                    "MEASUREMENT_WINDOW_NOT_AVAILABLE",
                    "SNAPSHOT_NOT_AVAILABLE",
                    "TARGET_NOT_IN_WINDOW_SCOPE",
                    "UNKNOWN_TARGET"
                  ]
                }
              }
            },
            "maxItems": 1,
            "minItems": 1
          },
          "outcome": {
            "const": "NOT_ANSWERED"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "data": {
                "type": "null"
              }
            },
            "required": [
              "data"
            ]
          },
          {
            "properties": {
              "mode": {
                "const": "evidence"
              }
            },
            "required": [
              "mode"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "items": {
              "properties": {
                "code": {
                  "enum": [
                    "MEASUREMENT_WINDOW_NOT_AVAILABLE",
                    "SNAPSHOT_NOT_AVAILABLE",
                    "TARGET_NOT_IN_WINDOW_SCOPE",
                    "UNKNOWN_TARGET"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ANSWERED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "PARTIAL"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "snapshot": {
            "type": "null"
          }
        },
        "required": [
          "snapshot"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "contains": {
              "properties": {
                "code": {
                  "enum": [
                    "SNAPSHOT_NOT_AVAILABLE"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "limitations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "not": {
              "type": "null"
            }
          },
          "mode": {
            "const": "query"
          },
          "outcome": {
            "const": "NOT_ANSWERED"
          }
        },
        "required": [
          "mode",
          "outcome",
          "data"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "contains": {
              "properties": {
                "code": {
                  "enum": [
                    "NO_ROUTE_SELECTED"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "limitations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "not": {
              "type": "null"
            }
          },
          "mode": {
            "const": "evidence"
          },
          "outcome": {
            "const": "NOT_ANSWERED"
          }
        },
